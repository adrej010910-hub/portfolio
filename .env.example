# =====================================================
# Портфолио — переменные окружения
# Скопируйте в .env.local для локальной разработки.
# Для продакшена добавьте их в Vercel → Settings → Environment Variables
# =====================================================

# Токен Telegram-бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Ваш Telegram ID (доступ к /stats) — через запятую для нескольких
TELEGRAM_ADMIN_IDS=123456789

# Секрет для настройки webhook (любая строка)
WEBHOOK_SECRET=my-secret

# Токен для просмотра статистики через API /api/stats
STATS_API_TOKEN=my-stats-token

# Vercel KV — появятся автоматически после подключения KV Store
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
